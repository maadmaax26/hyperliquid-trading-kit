# ── Hyperliquid Market Maker Bot Configuration ──
# Copy this file to .env and fill in YOUR wallet details.
#
# The MM bot runs on the SAME parent account as the scalper bot,
# but trades DIFFERENT coins (non-overlapping) to avoid position conflicts.
#
# HOW TO GET THESE:
# Same as scalper — uses the same API agent key and parent wallet.
# Both bots share one API agent wallet.

# API agent private key (same as scalper)
HL_PRIVATE_KEY=0xYOUR_API_AGENT_PRIVATE_KEY_HERE

# Parent wallet address (same as scalper)
HL_PARENT_ADDRESS=0xYOUR_PARENT_WALLET_ADDRESS

# Sub-account address (leave empty to run on parent account)
HL_SUB_ACCOUNT=

# Mainnet or testnet
USE_MAINNET=true

# The MM bot runs on the PARENT account with non-overlapping coins.
# Scalper trades: BTC, ETH, SOL, XRP, ZEC, PAXG
# MM bot trades: kPEPE, kBONK, ARB (or your choice)
# DO NOT overlap coins — positions will net against each other.