# ── Hyperliquid Scalper Bot Configuration ──
# Copy this file to .env and fill in YOUR wallet details.
#
# HOW TO GET THESE:
# 1. Go to app.hyperliquid.xyz
# 2. Connect your wallet (MetaMask, Rabby, etc.)
# 3. Generate an API wallet: Settings → API → Generate
# 4. Copy the private key and wallet address
#
# Your PARENT wallet = the wallet that holds your USDC on Hyperliquid
# Your API AGENT wallet = the wallet generated above (trades on behalf of parent)

# API agent private key (used to sign trades)
HL_PRIVATE_KEY=0xYOUR_API_AGENT_PRIVATE_KEY_HERE

# Parent wallet address (holds the USDC, receives the trades)
PARENT_ADDRESS=0xYOUR_PARENT_WALLET_ADDRESS

# Mainnet or testnet
USE_MAINNET=true